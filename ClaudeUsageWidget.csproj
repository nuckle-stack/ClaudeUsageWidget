<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClaudeUsageWidget</AssemblyName>
    <RootNamespace>ClaudeUsageWidget</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Raise it for each release (release.ps1 publishes it as tag v<Version>). -->
    <Version>1.3.0</Version>
  </PropertyGroup>

  <!-- WinForms is only here for the tray icon; keep its types out of the
       implicit usings so they don't clash with the WPF ones. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- The tests live in a subfolder, which the SDK would otherwise compile
       into the widget. They see the internals (test hooks, title matching). -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <InternalsVisibleTo Include="ClaudeUsageWidget.Tests" />
  </ItemGroup>

</Project>
