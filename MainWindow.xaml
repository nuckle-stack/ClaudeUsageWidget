<Window x:Class="ClaudeUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI" FontSize="11">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="Track" TargetType="Border">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Margin" Value="7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Fill" TargetType="Border">
            <Setter Property="Height" Value="6"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="8" Background="#F015151A" BorderBrush="#30FFFFFF"
            BorderThickness="1" Padding="10,6" MouseLeftButtonDown="OnDrag">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Sessões ativas" Click="OnSessions"/>
                <MenuItem x:Name="GoToWaitingMenu" Header="Ir para a sessão à tua espera" Click="OnGoToWaiting"/>
                <MenuItem x:Name="QuietMenu" Header="Não incomodar"/>
                <MenuItem x:Name="SoundMenu" Header="Som dos avisos" IsCheckable="True" Click="OnToggleSound"/>
                <MenuItem Header="Definições…" Click="OnSettings"/>
                <MenuItem Header="Atualizar agora" Click="OnHelloNow"/>
                <MenuItem Header="Copiar diagnóstico" Click="OnCopyDiagnostics"/>
                <MenuItem x:Name="UpdateMenu" Header="Procurar versão nova" Click="OnUpdate"/>
                <Separator/>
                <MenuItem Header="Esconder" Click="OnHide"/>
                <MenuItem Header="Sair" Click="OnExit"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="17"/>
                <RowDefinition Height="17"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="54"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="5h" Style="{StaticResource Label}"/>
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Track}">
                <Border x:Name="Fill5" Style="{StaticResource Fill}" Width="0"/>
            </Border>
            <TextBlock x:Name="Pct5" Grid.Row="0" Grid.Column="2" Text="--" Style="{StaticResource Value}" FontWeight="SemiBold"/>
            <TextBlock x:Name="Time5" Grid.Row="0" Grid.Column="3" Text="" Style="{StaticResource Value}" Foreground="#99FFFFFF"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="7d" Style="{StaticResource Label}"/>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Track}">
                <Border x:Name="Fill7" Style="{StaticResource Fill}" Width="0"/>
            </Border>
            <TextBlock x:Name="Pct7" Grid.Row="1" Grid.Column="2" Text="--" Style="{StaticResource Value}" FontWeight="SemiBold"/>
            <TextBlock x:Name="Time7" Grid.Row="1" Grid.Column="3" Text="" Style="{StaticResource Value}" Foreground="#99FFFFFF"/>

            <!-- Shown while "do not disturb" is on. -->
            <TextBlock x:Name="QuietIcon" Grid.RowSpan="2" Grid.ColumnSpan="4" Text="&#xE708;"
                       FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="#B3FFFFFF"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-7,0"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
