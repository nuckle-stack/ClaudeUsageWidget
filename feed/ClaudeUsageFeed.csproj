<Project Sdk="Microsoft.NET.Sdk">

  <!-- Claude Code's statusline command and Notification hook for the widget.
       Claude Code starts it on every statusline refresh, so it is a small
       console program on its own, not the widget: trimmed, invariant culture,
       no WPF. It replaces feed.ps1 and notify.ps1, so nothing needs PowerShell. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudeUsageFeed</AssemblyName>
    <RootNamespace>ClaudeUsageFeed</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- No commit id in the version: the build is then the same bytes until
         the feed's own code changes, so an update brings no new 16 MB exe for
         the antivirus to look at, and the installer leaves it in place. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClaudeUsageWidget.Tests" />
  </ItemGroup>

</Project>
